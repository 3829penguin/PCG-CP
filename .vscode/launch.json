{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug with Makefile",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/pcg_cp",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "make build_debug",
      "setupCommands": [
        { "description": "啟用 gdb 的美化顯示", "text": "-enable-pretty-printing", "ignoreFailures": true },
        { "description": "Intel 反組譯格式", "text": "-gdb-set disassembly-flavor intel", "ignoreFailures": true }
      ]
    }
  ]
}
